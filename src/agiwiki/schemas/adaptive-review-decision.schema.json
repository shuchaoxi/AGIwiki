{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agiwiki.dev/schemas/adaptive-review-decision.schema.json",
  "title": "AGIWiki Adaptive Memory Review Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "proposal_id", "proposal_digest", "decisions"],
  "properties": {
    "contract_version": {"const": "agiwiki.adaptive-review-decision.v1"},
    "proposal_id": {"type": "string", "pattern": "^review_[0-9a-f]{32}$"},
    "proposal_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "decision", "selected_action"],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^candidate_[0-9a-f]{32}$"},
          "decision": {"enum": ["accepted", "rejected", "deferred"]},
          "selected_action": {
            "type": ["string", "null"],
            "enum": ["forget", "correct", "keep_one", "forget_redundant", null]
          }
        }
      }
    }
  }
}
