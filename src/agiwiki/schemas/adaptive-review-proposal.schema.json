{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agiwiki.dev/schemas/adaptive-review-proposal.schema.json",
  "title": "AGIWiki Adaptive Memory Review Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "proposal_id",
    "scope",
    "generated_at",
    "snapshot_digest",
    "proposal_digest",
    "counts",
    "scan_truncated",
    "candidates",
    "contains_memory_content",
    "mutations_applied",
    "model_invoked"
  ],
  "properties": {
    "contract_version": {"const": "agiwiki.adaptive-review-proposal.v1"},
    "proposal_id": {"type": "string", "pattern": "^review_[0-9a-f]{32}$"},
    "scope": {"$ref": "#/$defs/scope"},
    "generated_at": {"type": "string", "format": "date-time"},
    "snapshot_digest": {"$ref": "#/$defs/digest"},
    "proposal_digest": {"$ref": "#/$defs/digest"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanned",
        "current",
        "expired",
        "scheduled",
        "exact_duplicate_groups",
        "candidates"
      ],
      "properties": {
        "scanned": {"type": "integer", "minimum": 0, "maximum": 500},
        "current": {"type": "integer", "minimum": 0, "maximum": 500},
        "expired": {"type": "integer", "minimum": 0, "maximum": 500},
        "scheduled": {"type": "integer", "minimum": 0, "maximum": 500},
        "exact_duplicate_groups": {"type": "integer", "minimum": 0, "maximum": 500},
        "candidates": {"type": "integer", "minimum": 0, "maximum": 500}
      }
    },
    "scan_truncated": {"type": "boolean"},
    "candidates": {
      "type": "array",
      "maxItems": 500,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "contains_memory_content": {"const": false},
    "mutations_applied": {"const": false},
    "model_invoked": {"const": false}
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key"],
      "properties": {
        "type": {"enum": ["user", "agent", "run", "workspace"]},
        "key": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "reason",
        "memory_ids",
        "lineage_ids",
        "memory_classes",
        "suggested_actions"
      ],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^candidate_[0-9a-f]{32}$"},
        "reason": {"enum": ["expired", "exact_duplicate_content"]},
        "memory_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^mem_[0-9a-f]{32}$"}
        },
        "lineage_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^lineage_[0-9a-f]{32}$"}
        },
        "memory_classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["profile", "episode"]}
        },
        "suggested_actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["forget", "correct", "keep_one", "forget_redundant"]}
        }
      }
    }
  }
}
