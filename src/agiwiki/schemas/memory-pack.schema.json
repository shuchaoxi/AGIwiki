{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agiwiki.net/schemas/memory-pack.v2.json",
  "title": "AGIWiki immutable portable Memory Pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "format",
    "quality_policy",
    "workspace",
    "workspace_id",
    "workspace_digest",
    "pack_id",
    "source_count",
    "sources_digest",
    "source_refs",
    "entry_count",
    "entries_digest",
    "entry_refs",
    "outputs",
    "manifest_digest"
  ],
  "properties": {
    "contract_version": {"const": "agiwiki.memory-pack.v2"},
    "format": {"const": "portable-json-directory-v1"},
    "quality_policy": {"const": "agiwiki.entry-quality.v1"},
    "workspace": {
      "$ref": "https://agiwiki.net/schemas/workspace.v1.json"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^ws_[a-f0-9]{32}$"
    },
    "workspace_digest": {"$ref": "#/$defs/digest"},
    "pack_id": {
      "type": "string",
      "pattern": "^pack_[a-f0-9]{32}$"
    },
    "source_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "sources_digest": {"$ref": "#/$defs/digest"},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceRef"}
    },
    "entry_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "entries_digest": {"$ref": "#/$defs/digest"},
    "entry_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/entryRef"}
    },
    "outputs": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 10001,
      "propertyNames": {
        "pattern": "^(?:sources\\.json|entries/entryv_[a-f0-9]{32}\\.json)$"
      },
      "additionalProperties": {"$ref": "#/$defs/digest"}
    },
    "manifest_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_digest"],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^src_[a-f0-9]{32}$"
        },
        "source_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "entryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "entry_version_id", "entry_digest", "path"],
      "properties": {
        "entry_id": {
          "type": "string",
          "pattern": "^entry_[a-f0-9]{32}$"
        },
        "entry_version_id": {
          "type": "string",
          "pattern": "^entryv_[a-f0-9]{32}$"
        },
        "entry_digest": {"$ref": "#/$defs/digest"},
        "path": {
          "type": "string",
          "pattern": "^entries/entryv_[a-f0-9]{32}\\.json$"
        }
      }
    }
  }
}
