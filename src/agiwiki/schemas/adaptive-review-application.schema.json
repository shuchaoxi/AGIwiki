{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agiwiki.dev/schemas/adaptive-review-application.schema.json",
  "title": "AGIWiki Adaptive Memory Review Application",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "decision_id",
    "proposal_id",
    "proposal_digest",
    "applications"
  ],
  "properties": {
    "contract_version": {"const": "agiwiki.adaptive-review-application.v1"},
    "decision_id": {"type": "string", "pattern": "^decision_[0-9a-f]{32}$"},
    "proposal_id": {"type": "string", "pattern": "^review_[0-9a-f]{32}$"},
    "proposal_digest": {"$ref": "#/$defs/digest"},
    "applications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {"$ref": "#/$defs/application"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "action", "keep_memory_id"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^candidate_[0-9a-f]{32}$"},
        "action": {"enum": ["forget", "keep_one", "forget_redundant"]},
        "keep_memory_id": {
          "type": ["string", "null"],
          "pattern": "^mem_[0-9a-f]{32}$"
        }
      }
    }
  }
}
