{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agiwiki.net/schemas/author-batch-result.v1.json",
  "title": "AGIWiki authoring batch result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "plan_id",
    "batch_id",
    "outcome",
    "measurement_source",
    "input_tokens",
    "output_tokens",
    "entry_ids"
  ],
  "properties": {
    "contract_version": {"const": "agiwiki.author-batch-result.v1"},
    "plan_id": {"type": "string", "pattern": "^authorplan_[a-f0-9]{32}$"},
    "batch_id": {"type": "string", "pattern": "^authorbatch_[a-f0-9]{32}$"},
    "outcome": {"enum": ["completed", "skipped"]},
    "measurement_source": {"enum": ["provider", "agent", "unavailable"]},
    "input_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "output_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "entry_ids": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^entry_[a-f0-9]{32}$"}
    },
    "result_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "completed"}}},
      "then": {"properties": {"entry_ids": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "skipped"}}},
      "then": {"properties": {"entry_ids": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"measurement_source": {"const": "unavailable"}}},
      "then": {
        "properties": {
          "input_tokens": {"const": 0},
          "output_tokens": {"const": 0}
        }
      }
    }
  ]
}
